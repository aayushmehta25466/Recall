{
  "manifest_version": 3,
  "name": "Recall",
  "version": "1.0.0",
  "description": "AI-powered bookmark organizer for Chrome.",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "sidePanel",
    "windows"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "extension/popup/popup.html"
  },
  "side_panel": {
    "default_path": "extension/sidepanel/sidepanel.html"
  },
  "options_page": "extension/options/options.html",
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Recall sidebar"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
