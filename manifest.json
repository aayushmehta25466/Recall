{
  "manifest_version": 3,
  "name": "Recall",
  "version": "1.0.0",
  "description": "AI-powered bookmark organizer for Chromium and Firefox.",
  "chromium:permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "firefox:permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting"
  ],
  "chromium:background": {
    "service_worker": "extension/background/background.js",
    "type": "module"
  },
  "firefox:background": {
    "scripts": ["extension/background/background.js"]
  },
  "action": {
    "default_popup": "extension/popup/popup.html"
  },
  "chromium:side_panel": {
    "default_path": "extension/sidepanel/sidepanel.html"
  },
  "firefox:sidebar_action": {
    "default_panel": "extension/sidepanel/sidepanel.html",
    "default_title": "Recall"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "recall@aayushmehta25466",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["bookmarksInfo", "websiteContent"]
      }
    }
  },
  "options_page": "extension/options/options.html",
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Recall sidebar"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
